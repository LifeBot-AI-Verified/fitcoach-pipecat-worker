# Required secrets. Fill these in locally or in your deployment environment.
OPENAI_API_KEY=
WHATSAPP_CALL_WORKER_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional server/runtime settings.
PORT=7860
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional TTS settings.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Habla en español natural, con tono cercano, cálido y profesional. Suena como una entrenadora personal por teléfono, no como un contestador. Mantén un ritmo calmado y claro, con energía amable y no exagerada.
